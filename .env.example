# AI Chat - Choose one provider:
#
# Option 1: OpenRouter (recommended - access to GPT-4o, Claude, etc.)
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o
#
# Option 2: OpenAI direct
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ElevenLabs API Key (optional - for natural voice narration)
NEXT_PUBLIC_ELEVENLABS_API_KEY=

# Backend API URL (NestJS — Oracle VM)
NEXT_PUBLIC_API_URL=https://api.solascripturabr.com.br/api/v1
BACKEND_URL=https://api.solascripturabr.com.br/api/v1

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Push Notifications (VAPID)
# Gere as chaves com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mercado Pago (checkout vitalício R$20 — /assinar)
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Sem MERCADO_PAGO_ACCESS_TOKEN o checkout entra em modo demo (mock).
# O webhook em /api/pagamento/webhook exige MERCADO_PAGO_WEBHOOK_SECRET
# (assinatura HMAC gerada ao cadastrar a URL no painel do MP).
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=https://solascripturabr.com.br

# Admin (e-mails separados por vírgula)
ADMIN_EMAILS=
